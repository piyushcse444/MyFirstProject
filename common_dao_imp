				.substring((LOWEST_PERIOD_SPREAD_DESCstr.indexOf("|") + 2), LOWEST_PERIOD_SPREAD_DESCstr.length())
				.substring(0, (LOWEST_PERIOD_SPREAD_DESCstr.substring((LOWEST_PERIOD_SPREAD_DESCstr.indexOf("|") + 2),
						LOWEST_PERIOD_SPREAD_DESCstr.length()).indexOf(" ")));
		int x = Integer.parseInt(temporspr);
//		 logger.info("lowest spr int val-->"+x);

		String tempmodspr = MODIFIED_PERIOD_SPREAD_DESCstr
				.substring((MODIFIED_PERIOD_SPREAD_DESCstr.indexOf("|") + 2), MODIFIED_PERIOD_SPREAD_DESCstr.length())
