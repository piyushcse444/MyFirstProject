	public int updateTable(String userName, String newPassword) throws DAOException {
		logger.info("updateTable method begin");
		final String UPDATE_PASSWORD = "UPDATE BCQI_USER_PROFILE SET  PASSWORD=? WHERE USER_ID=?";
		int noOfRow = 0;
		try {
			int[] type = { Types.VARCHAR, Types.VARCHAR };
			final String encPassword = SHAEncryption.hashingSHA2(userName + "#" + newPassword);
			Object[] param = new Object[] { encPassword, userName };

			noOfRow = getJdbcTemplate().update(UPDATE_PASSWORD, param, type);

			logger.info(noOfRow + " Rows Updated Successfully.");
		} catch (DataAccessException exception) {
			logger.error("Exception Occured : " + exception.getMessage(), exception);
			DAOException.throwException("BC000");
		}
		logger.info("updateTable method end");
		return noOfRow;
	}

