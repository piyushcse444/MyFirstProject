								MODIFIED_PERIOD_SPREAD_DESCstr.length()).indexOf(" ")));
		int y = Integer.parseInt(tempmodspr);
//		 logger.info("modified spr int val-->"+y);

		int dif = y - x;
//		 logger.info("difference spr int val-->"+dif);

		if (dif < 0) {
			return Integer.toString(0);
		} else {
			return Integer.toString(dif);
		}

