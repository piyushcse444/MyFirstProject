    // piyush -> to authenticate using ldap
    private boolean authenticate_password(
            String userName,
            String password,
            String dbPassword,
            String key) {

        try {

            // 1. Try LDAP authentication first.
            boolean authenticated =
                    ldapService.authenticate(userName, password);

            if (authenticated) {

                logger.info("LDAP authentication successful for user");

                // 2. Update local DB password after successful LDAP login.
                String hashedPassword =
                        SHAEncryption.hashingSHA2(password);

                commonDAOImpl.updateUserPassword(
                        userName, hashedPassword);

                return true;
            }

            // LDAP is available but credentials are incorrect.
            logger.info("LDAP authentication failed");
            return false;

        } catch (LdapUnavailableException e) {

            // 3. LDAP unavailable: use existing DB authentication.
            logger.warn("LDAP unavailable. Using DB authentication.");

            try {

                String hashedPassword =
                        SHAEncryption.hashingSHA2(password);

                return hashedPassword.equals(dbPassword);

            } catch (Exception ex) {

                logger.error("DB password verification failed", ex);
                return false;
            }
        }
    }


