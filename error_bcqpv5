package com.sbi.ldap;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

@Component
public class LdapProperties {

    @Value("${ldap.authenticationEnabled:true}")
    private boolean authenticationEnabled;

    @Value("${ldap.url}")
    private String url;

    @Value("${ldap.searchUrl:}")
    private String searchUrl;

    @Value("${ldap.bindUrl:}")
    private String bindUrl;

    @Value("${ldap.baseDn}")
    private String baseDn;

    @Value("${ldap.userSearchFilter}")
    private String userSearchFilter;

    @Value("${ldap.serviceAccountDn}")
    private String serviceAccountDn;

    @Value("${ldap.serviceAccountPassword}")
    private String serviceAccountPassword;

    @Value("${ldap.connectTimeout:5000}")
    private int connectTimeout;

    @Value("${ldap.readTimeout:5000}")
    private int readTimeout;

    @Value("${ldap.truststorePath:}")
    private String truststorePath;

    @Value("${ldap.truststorePassword:}")
    private String truststorePassword;

    @Value("${ldap.truststoreType:JKS}")
    private String truststoreType;

    // Keep your existing getters and setters
}