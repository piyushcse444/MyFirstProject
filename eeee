import com.sbi.handler.CaptchaHandler;
import com.sbi.handler.ForgotPasswordHandler;
import com.sbi.interceptor.CustomRequestInterceptor;

/**
 * @author 8389845
 *
 */
	
@Configuration
@EnableWebMvc
@ComponentScan(basePackages = { "com.bcqp.config","com.sbi.edms.integration", "com.sbi.handler", "Log4j.init", "com.sbi.filter",
        "com.sbi.dao", "com.sbi.utils", "com.sbi.service", "com.sbi.bp", "com.sbi.listener",
        "com.sbi.interceptor", "com.sbi.model", "com.sbi.common.utils", "com.sbi.common.exception",
        "com.sbi.exception","com.sbi.ldap" })
public class ApplicationConfiguration implements WebMvcConfigurer {

    @Autowired
    CustomRequestInterceptor customRequestInterceptor;

    protected static final Logger logger = LogManager.getLogger(ApplicationConfiguration.class);

    @Bean
    public TilesConfigurer tileConfigurer() {
    	//System.out.println("------------------TilesConfigurer------------------");
        TilesConfigurer tilesConfigurer = new TilesConfigurer();
        tilesConfigurer.setDefinitions(new String[] { "/WEB-INF/xmlconfig/bcqi-tilesdefinition.xml" });
        return tilesConfigurer;
    }
    
    @Bean
    public CaptchaHandler captchaHandler() {
//        System.out.println("==========================================");
//        System.out.println(">>> Creating CaptchaHandler Bean <<<");
//        System.out.println("==========================================");
        return new CaptchaHandler();
    }


    // Configure the Tiles view resolver with high priority
    @Bean
    public TilesViewResolver tilesViewResolver() {
    	//System.out.println("------------------TilesViewResolver------------------");
        TilesViewResolver resolver = new TilesViewResolver();
        resolver.setOrder(1); // Set a low order value for high priority
        return resolver;
    }

    // configure of ldap service
    @Bean
    public LdapAuthService ldapAuthService() {
        //System.out.println("------------------TilesViewResolver------------------");
        LdapAuthService ldapAuthService = new LdapAuthService();
        resolver.setOrder(1); // Set a low order value for high priority
        return resolver;
    }

    // Configure the InternalResourceViewResolver with lower priority
    // It will be used as a fallback for standard JSPs
    @Bean
    public InternalResourceViewResolver internalResourceViewResolver() {
    	//System.out.println("------------------internalResource------------------");
        InternalResourceViewResolver resolver = new InternalResourceViewResolver();
        resolver.setPrefix("/WEB-INF/jsp/"); 
        resolver.setSuffix(".jsp"); 
        resolver.setOrder(2); 
        return resolver;
        
    }

    @Bean
    public static PropertySourcesPlaceholderConfigurer propertyConfigurer() {
        PropertySourcesPlaceholderConfigurer configurer = new PropertySourcesPlaceholderConfigurer();
        configurer.setLocation(new ClassPathResource("/WEB-INF/conf/config.properties"));
        return configurer;
    }

    @Bean
    public RequestMappingHandlerAdapter handlerAdapter() {
        RequestMappingHandlerAdapter adapter = new RequestMappingHandlerAdapter();
        return adapter;
    }

    @Bean
    public RequestMappingHandlerMapping handlerMapping() {
        RequestMappingHandlerMapping mapping = new RequestMappingHandlerMapping();
        return mapping;
    }

    @Bean
    public CustomRequestInterceptor customRequestInterceptor() {
        return new CustomRequestInterceptor();
    }

    @Override
    public void addInterceptors(InterceptorRegistry registry) {
        registry.addInterceptor(customRequestInterceptor());
    }
    
    @Bean
    public RestTemplate restTemplate() {
        return new RestTemplate();
    }
    
    @Bean
    public ObjectMapper objectMapper() {
        return new ObjectMapper();
    }
        
    @Bean
    public DwrAnnotationPostProcessor dwrAnnotationPostProcessor() {
        return new DwrAnnotationPostProcessor();
    }  
    
    @Bean
    public org.directwebremoting.spring.DwrSpringServlet dwrSpringServlet() {
        return new org.directwebremoting.spring.DwrSpringServlet();
    }
}
    




