	//added by nitin 
	public final static String FO_INBOX = "SELECT  B.REFERENCE_NO,TO_CHAR(D.REQ_CREATED_DATE)REQ_CREATED_DATE,D.BRANCH_NAME,"
			+ "D.NAME_OF_IMPORTER,D.AMOUNT,(SELECT VALUE FROM  BCQI_PROPERTIES  WHERE DESCRIPTION = 'Currency' AND "
			+ "CONFIG_ID = D.CURRENCY) CURRENCY,(SELECT VALUE FROM  BCQI_PROPERTIES  WHERE DESCRIPTION = 'SHIPMENT' "
			+ "AND CONFIG_ID = D.SHIPMENT_FROM) SHIPMENT_FROM, "
			+ " (SELECT VALUE FROM  BCQI_PROPERTIES  WHERE DESCRIPTION = 'SHIPMENT' AND CONFIG_ID = D.SHIPMENT_TO) "
			+ "SHIPMENT_TO,D.PERIOD_TENOR_DAYS,TO_CHAR(D.EXP_DRAWDOWN_DATE)EXP_DRAWDOWN_DATE,D.CREDIT_RATING_IMPORTER "
			+ "FROM  BCQI_REQUEST B,BCQI_REQUEST_DETAILS D WHERE B.IS_ACTIVE = 'YES' "
			+ "AND   B.STATUS IN ('2','5','20','25','26','27') AND   B.REFERENCE_NO=D.REFERENCE_NO AND   NOT EXISTS "
			+ "(SELECT 1 FROM BCQI_REQ_QUOTE_DETAILS C where C.REFERENCE_NO=B.REFERENCE_NO and fo_user_branch = ?) "
			+ "AND EXISTS  (SELECT 1  FROM BCQI_COUNTRYS a  WHERE  a.country_code =?  AND REQUEST_VISIBLE_TO_FO='Y' "
			+ "AND a.country_code= (CASE "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='USD' THEN 91 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='EUR' THEN 49 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='JPY' THEN 81 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='SGD' THEN 65 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='HKD' THEN 852 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='AUD' THEN 61 "
			+ "WHEN (SELECT VALUE from BCQI_PROPERTIES where DESCRIPTION = 'Currency' AND CONFIG_ID=D.CURRENCY)='GBP' THEN 44 "
			+ "ELSE a.country_code END)) "
			+ "and B.GTD_ACTION_REQUIRED = 'N' ORDER BY B.CREATION_TIME desc";
	
	
